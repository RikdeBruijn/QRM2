require(tidyverse)
require(rmarkdown)
require(yaml)
library(readxl)
library(cbsodataR)
library(sf)
#renaming and reading data
movies_one <- read_tsv("Data/movies1.tsv")
#WRITE YOUR CODE HERE
nrow(movies_one)
#observations
ncol(movies_one)
# variables
n_distinct(movies_one$title)
#unique movies (subjects)
glimpse(movies_one)
#all variables
#WRITE YOUR CODE HERE
glimpse(movies_one)                 # overview of variable types
unique(movies_one$genre)            # nominal: categories without order
summary(movies_one$popularity)      # continuous: decimal values
summary(movies_one$vote_count)      # discrete: whole numbers (counts)
knitr::opts_chunk$set(echo = TRUE)
#WRITE YOUR CODE HERE
summary(movies_one$revenue)
mean(movies_one$revenue)
median(movies_one$revenue)
max(movies_one$revenue)
min(movies_one$revenue)
