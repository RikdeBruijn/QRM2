knitr::opts_chunk$set(echo = TRUE)
#WRITE YOUR CODE HERE
movies_one$log_revenue <- log(movies_one$revenue)
sum(movies_one$revenue == 0)
mean(movies_one$log_revenue)
#WRITE YOUR CODE HERE
ggplot(movies_one, aes(x = revenue)) +
geom_histogram(bins = 30) +
scale_x_continuous(labels = scales::label_number(scale = 1e-6, suffix = "M")) +
labs(title = "Histogram of movie revenue",
x = "Revenue (in millions of dollars)",
y = "Number of movies")
knitr::opts_chunk$set(echo = TRUE)
#WRITE YOUR CODE HERE
movies_one$log_revenue <- ifelse(movies_one$revenue == 0, NA, log(movies_one$revenue))
mean(movies_one$log_revenue, na.rm = TRUE)
ggplot(movies_one, aes(x = log_revenue)) +
geom_histogram(bins = 30, na.rm = TRUE) +
labs(title = "Histogram of log revenue",
x = "Log of revenue",
y = "Number of movies")
knitr::opts_chunk$set(echo = TRUE)
