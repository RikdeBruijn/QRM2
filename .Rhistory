mean(movies_one$log_revenue, na.rm = TRUE)
ggplot(movies_one, aes(x = log_revenue)) +
geom_histogram(bins = 30, na.rm = TRUE) +
labs(title = "Histogram of log revenue",
x = "Log of revenue",
y = "Number of movies")
