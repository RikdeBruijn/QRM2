#WRITE YOUR CODE HERE
summary(sample_means)
sd(sample_means)
ggplot(data.frame(sample_means), aes(x = sample_means)) +
geom_histogram(bins = 15) +
labs(title = "Histogram of sample means of vote_average (100 samples of n = 25)",
x = "Sample mean of vote_average",
y = "Number of samples")
pop_mean <- mean(movies_one$vote_average)
pop_sd <- sd(movies_one$vote_average)
pop_mean                     # expected value of the sample mean
pop_sd / sqrt(25)            # standard deviation (standard error) of the sample mean
#WRITE YOUR CODE HERE
# Theoretical values for a discrete uniform distribution on {1, 2, ..., 12}
n <- 12
theoretical_mean <- (1 + n) / 2
theoretical_sd <- sqrt((n^2 - 1) / 12)
theoretical_mean
theoretical_sd
# Actual mean and sd in the data
mean(movies_one$release_month)
sd(movies_one$release_month)
# Histogram with the discrete uniform distribution overlaid
ggplot(movies_one, aes(x = release_month)) +
geom_histogram(aes(y = after_stat(count)), binwidth = 1, boundary = 0.5) +
geom_hline(yintercept = nrow(movies_one) / n, color = "red", linewidth = 1) +
scale_x_continuous(breaks = 1:12) +
labs(title = "Histogram of release month vs. discrete uniform distribution",
x = "Release month",
y = "Number of movies")
#WRITE YOUR CODE HERE
n <- length(movies_one$revenue)
mean_revenue <- mean(movies_one$revenue)
sd_revenue <- sd(movies_one$revenue)
se_revenue <- sd_revenue / sqrt(n)
t_crit <- qt(0.95, df = n - 1)
lower <- mean_revenue - t_crit * se_revenue
upper <- mean_revenue + t_crit * se_revenue
lower
upper
#WRITE YOUR CODE HERE
table(movies_one$director_gender)
sum(movies_one$director_gender == "male", na.rm = TRUE)
sum(movies_one$director_gender == "female", na.rm = TRUE)
#WRITE YOUR CODE HERE
binom.test(x = 426, n = 426 + 44, p = 0.5)
#WRITE YOUR CODE HERE
movies_one$revenue_millions <- movies_one$revenue / 1e6
var(movies_one$revenue_millions[movies_one$director_gender == "male"], na.rm = TRUE)
var(movies_one$revenue_millions[movies_one$director_gender == "female"], na.rm = TRUE)
#WRITE YOUR CODE HERE
sigma_sq_male <- var(movies_one$revenue_millions[movies_one$director_gender == "male"], na.rm = TRUE)  # treated as known population variance
s_sq_female <- var(movies_one$revenue_millions[movies_one$director_gender == "female"], na.rm = TRUE)
n_female <- sum(movies_one$director_gender == "female", na.rm = TRUE)
chi_sq_stat <- (n_female - 1) * s_sq_female / sigma_sq_male
chi_sq_stat
df <- n_female - 1
df
p_value <- 2 * min(pchisq(chi_sq_stat, df), 1 - pchisq(chi_sq_stat, df))
p_value
#WRITE YOUR CODE HERE
yearly_revenue <- movies_one %>%
group_by(release_year) %>%
summarize(mean_revenue = mean(revenue))
ggplot(yearly_revenue, aes(x = release_year, y = mean_revenue)) +
geom_point() +
labs(title = "Mean movie revenue by release year",
x = "Release year",
y = "Mean revenue (dollars)")
#WRITE YOUR CODE HERE
yearly_revenue <- movies_one %>%
group_by(release_year) %>%
summarize(mean_revenue = mean(revenue),
sd_revenue = sd(revenue),
n = n(),
se = sd_revenue / sqrt(n),
t_crit = qt(0.975, df = n - 1),
ci_lower = mean_revenue - t_crit * se,
ci_upper = mean_revenue + t_crit * se)
ggplot(yearly_revenue, aes(x = release_year, y = mean_revenue)) +
geom_point() +
geom_errorbar(aes(ymin = ci_lower, ymax = ci_upper)) +
labs(title = "Mean movie revenue by release year, with 95% confidence intervals",
x = "Release year",
y = "Mean revenue (dollars)")
#WRITE YOUR CODE HERE
yearly_revenue %>%
arrange(desc(ci_upper - ci_lower)) %>%
select(release_year, n, sd_revenue, ci_lower, ci_upper)
