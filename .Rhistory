require(rmarkdown)
require(yaml)
library(readxl)
library(cbsodataR)
library(sf)
library(moments)
knitr::opts_chunk$set(echo = TRUE)
#WRITE YOUR CODE HERE
skewness(movies_one$revenue)
kurtosis(movies_one$revenue)
skewness(movies_one$log_revenue, na.rm = TRUE)
kurtosis(movies_one$log_revenue, na.rm = TRUE)
